rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/designs/{designId}
    // Document ID: the design's client UUID (same as the `id` field)
    // Fields:
    //   - id: string (required, immutable, 8-128 chars, must equal document ID)
    //   - ownerUid: string (required, immutable, must equal {userId} and auth.uid)
    //   - name: string (required, 1-200 chars)
    //   - width: number (required, 1-20000)
    //   - height: number (required, 1-20000)
    //   - pages: list (required, 1-50 maps). Each page:
    //       id: string, background: string, objects: list (0-250 maps),
    //       role?: "front" | "back" | "left-shoulder" | "right-shoulder"
    //     Nested canvas object strings are size-capped at the page/object
    //     count level; Firestore rules cannot iterate variable-length lists.
    //   - updatedAt: number (required, millisecond epoch, 1 .. 4102444800000)
    //   - shirt: map (optional) { color: string <= 32, neck: "crew" | "v" }
    //   - brandColors: list of strings (optional, 0-24)
    //   - folder: string (optional, 1-80)
    //
    // Collection: users/{userId}/brand/{docId}
    //   - colors: list of strings (optional)
    //
    // Collection: shares/{token}
    //   Public snapshot for a view-only link.
    //   Fields: ownerUid, name, width, height, pages, assetUrls, createdAt
    //
    // Uploaded image blobs: Firebase Storage users/{uid}/assets/{id} when signed in.
    // Signed-out stays IndexedDB on the device.
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function validCanvasSize(field) {
      return request.resource.data[field] is number &&
        request.resource.data[field] >= 1 &&
        request.resource.data[field] <= 20000;
    }

    function isValidShirt(data) {
      return !('shirt' in data) || (
        data.shirt is map &&
        data.shirt.keys().hasOnly(['color', 'neck']) &&
        data.shirt.color is string &&
        data.shirt.color.size() >= 1 &&
        data.shirt.color.size() <= 32 &&
        data.shirt.neck in ['crew', 'v']
      );
    }

    function isValidPages(pages) {
      return pages is list &&
        pages.size() >= 1 &&
        pages.size() <= 50;
    }

    function isValidBrandColors(data) {
      return !('brandColors' in data) || (
        data.brandColors is list &&
        data.brandColors.size() <= 24
      );
    }

    function isValidFolder(data) {
      return !('folder' in data) || (
        data.folder is string &&
        data.folder.size() >= 1 &&
        data.folder.size() <= 80
      );
    }

    function isValidShare(data) {
      return data.keys().hasOnly(['ownerUid', 'name', 'width', 'height', 'pages', 'assetUrls', 'createdAt']) &&
        data.ownerUid is string &&
        data.ownerUid == request.auth.uid &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 200 &&
        data.width is number &&
        data.width >= 1 &&
        data.width <= 20000 &&
        data.height is number &&
        data.height >= 1 &&
        data.height <= 20000 &&
        data.pages is list &&
        data.assetUrls is map &&
        data.createdAt is number &&
        data.createdAt > 0 &&
        data.createdAt < 4102444800000;
    }

    function isValidDesign(data, userId, designId) {
      return hasRequiredFields(['id', 'ownerUid', 'name', 'width', 'height', 'pages', 'updatedAt']) &&
        hasOnlyAllowedFields(['id', 'ownerUid', 'name', 'width', 'height', 'pages', 'updatedAt', 'shirt', 'brandColors', 'folder']) &&
        data.id is string &&
        data.id == designId &&
        data.id.size() >= 8 &&
        data.id.size() <= 128 &&
        data.ownerUid is string &&
        data.ownerUid == userId &&
        data.ownerUid == request.auth.uid &&
        validStringLength('name', 1, 200) &&
        validCanvasSize('width') &&
        validCanvasSize('height') &&
        isValidPages(data.pages) &&
        data.updatedAt is number &&
        data.updatedAt > 0 &&
        data.updatedAt < 4102444800000 &&
        isValidShirt(data) &&
        isValidBrandColors(data) &&
        isValidFolder(data);
    }

    match /users/{userId}/designs/{designId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidDesign(request.resource.data, userId, designId);

      allow update: if isOwner(userId) &&
        isValidDesign(request.resource.data, userId, designId) &&
        areImmutableFieldsUnchanged(['id', 'ownerUid']);

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/brand/{docId} {
      allow read, write: if isOwner(userId);
    }

    match /shares/{token} {
      allow read: if true;

      allow create: if isAuthenticated() && isValidShare(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        isValidShare(request.resource.data) &&
        areImmutableFieldsUnchanged(['ownerUid']);

      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
